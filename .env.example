# SQLite（Docker 中请保持 /data 路径）
DATABASE_URL=file:/data/askbox.db

# 管理员与加密密钥；生产环境请使用高强度随机值
ADMIN_PASSWORD=change-me-to-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-another-at-least-32-random-characters

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PUBLIC_URL=https://ask.akiyamamio.one/admin

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=ask.akiyamamio.one
TURNSTILE_ENABLED=true

# 仅当请求只能经过对应可信代理时启用
TRUST_CLOUDFLARE_PROXY=true
TRUST_PROXY=false

# 仅测试环境使用；生产环境启用会拒绝启动
EXTERNAL_SERVICES_MOCK=false

# 安全记录保留策略
LOGIN_ATTEMPT_RETENTION_DAYS=30

TZ=Asia/Shanghai

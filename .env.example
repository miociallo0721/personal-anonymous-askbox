# SQLite（Docker 中请保持 /data 路径）
DATABASE_URL=file:/data/askbox.db

# 管理员与加密密钥；生产环境请使用高强度随机值
ADMIN_PASSWORD=change-me-to-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-another-at-least-32-random-characters

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PUBLIC_URL=https://ask.example.com/admin

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=true

# 仅当请求只能经过对应可信代理时启用
TRUST_CLOUDFLARE_PROXY=true
TRUST_PROXY=false

# 仅供自动化测试使用 mock；生产环境必须保持 live
EXTERNAL_SERVICES_MODE=live

TZ=Asia/Shanghai
